### PACKAGING

ament_index(
    name = "ament_index",
    components = [
        ":filter_extract_indices_node_record",
        ":filter_passthrough_node_record",
        ":filter_project_inliers_node_record",
        ":filter_radius_outlier_removal_node_record",
        ":filter_statistical_outlier_removal_node_record",
        ":filter_crop_box_node_record",
        ":filter_voxel_grid_node_record",
        ":pcd_to_pointcloud_record",
        ":pointcloud_to_pcd_record",
        ":combined_pointcloud_to_pcd_record",
        ":bag_to_pcd_record",
        ":dummy_topics_node_record",
    ],
    libraries = [
        ":pcl_ros",
        ":dummy_topics",
    ],
    package_xml = "package.xml",
)

