load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "tf2_tools",
    srcs = glob(["tf2_tools/**/*.py"]),
    imports = ["."],
    deps = [
        "@rclpy",
        "@tf2_msgs//:py",
        "@tf2_ros_py",
    ],
)

py_binary(
    name = "view_frames",
    srcs = ["tf2_tools/view_frames.py"],
    main = "tf2_tools/view_frames.py",
    deps = [":tf2_tools"],
)

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_py//:ament_package",
        "@tf2_ros_py//:ament_package",
    ],
)
