load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
)

DEPENDENCIES = {
    "@camera_calibration_parsers//:camera_calibration_parsers": "@camera_calibration_parsers//:camera_calibration_parsers_library",
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@message_filters//:message_filters": "@message_filters//:message_filters_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "image_view_nodes_library",
    srcs = [
        "src/disparity_view_node.cpp",
        "src/extract_images_node.cpp",
        "src/image_saver_node.cpp",
        "src/image_view_node.cpp",
        "src/stereo_view_node.cpp",
        "src/utils.hpp",
        "src/video_recorder_node.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["COMPOSITION_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@sensor_msgs//:cc",
        "@std_srvs//:cc",
        "@stereo_msgs//:cc",
    ],
)

cc_shared_library(
    name = "image_view_nodes",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":image_view_nodes_library"],
    deps = [":image_view_nodes_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":image_view_nodes",
    ],
    visibility = ["//visibility:private"],
)

### EXECUTABLES

EXECUTABLES = [
    "disparity_view",
    "image_view",
    "stereo_view",
    "extract_images",
    "image_saver",
    "video_recorder",
]

[
    cc_binary(
        name = exe,
        srcs = ["src/{0}.cpp".format(exe)],
        dynamic_deps = [":transitive_dynamic_deps"],
        deps = DEPENDENCIES.values() + [
            ":image_view_nodes_library",
        ],
    )
    for exe in EXECUTABLES
]

### AMENT INDEX

ament_index(
    name = "ament_index",
    export_name = "image_view",
    libraries = [":image_view_nodes"],
    package_xml = "package.xml",
    plugin_category = "rclcpp_components",
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = [":" + exe for exe in EXECUTABLES],
    headers = HEADERS,
    libraries = [":image_view_nodes"],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake_auto//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@camera_calibration_parsers//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@message_filters//:ament_package",
        "@rclcpp//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_srvs//:ament_package",
        "@stereo_msgs//:ament_package",
    ],
)
