load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(
    [
        "include/**/*.h",
        "include/**/*.hpp",
    ],
    allow_empty = True,
)

cc_library(
    name = "tracetools_image_pipeline_library",
    srcs = [
        "src/tracetools.c",
        "src/utils.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
)

cc_shared_library(
    name = "tracetools_image_pipeline",
    exports_filter = [":tracetools_image_pipeline_library"],
    deps = [":tracetools_image_pipeline_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":tracetools_image_pipeline",
    ],
    visibility = ["//visibility:private"],
)

### EXECUTABLES

cc_binary(
    name = "status",
    srcs = [
        "src/status.c",
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = [
        ":tracetools_image_pipeline_library",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    executables = [
        ":status",
    ],
    headers = HEADERS,
    libraries = [
        ":tracetools_image_pipeline",
    ],
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
