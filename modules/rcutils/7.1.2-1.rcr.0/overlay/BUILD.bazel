[
    cc_test(
        name = test,
        timeout = "moderate",
        srcs = glob(["test/**/*.h"]) + ["test/benchmark/" + test + ".cpp"],
        tags = ["manual"],
        deps = [
            ":rcutils",
            "@google_benchmark//:benchmark",
            "@google_benchmark//:benchmark_main",
            "@osrf_testing_tools_cpp//:memory_tools",
