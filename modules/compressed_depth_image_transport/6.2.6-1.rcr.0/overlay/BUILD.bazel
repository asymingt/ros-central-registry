load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

HEADERS = glob(["include/**/*.hpp"])

CODECS_DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "codecs_library",
    srcs = [
        "src/codec.cpp",
        "src/rvl_codec.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = CODECS_DEPENDENCIES.values() + [
        "@rcl_interfaces//:cc",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "codecs",
    dynamic_deps = CODECS_DEPENDENCIES.keys(),
    exports_filter = [":codecs_library"],
    deps = [":codecs_library"],
)

TRANSPORT_DEPENDENCIES = {
    "@cv_bridge//:cv_bridge": "@cv_bridge//:cv_bridge_library",
    "@image_transport//:image_transport": "@image_transport//:image_transport_library",
    "@pluginlib//:pluginlib": "@pluginlib//:pluginlib_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rosdistro//cc:opencv": "@rosdistro//cc:opencv_library",
}

cc_library(
    name = "compressed_depth_image_transport_library",
    srcs = [
        "src/compressed_depth_publisher.cpp",
        "src/compressed_depth_subscriber.cpp",
        "src/manifest.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = TRANSPORT_DEPENDENCIES.values() + [
        ":codecs_library",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "compressed_depth_image_transport",
    dynamic_deps = TRANSPORT_DEPENDENCIES.keys() + [
        ":codecs",
    ],
    exports_filter = [":compressed_depth_image_transport_library"],
    deps = [":compressed_depth_image_transport_library"],
)

### TRANSITIVE DYNAMIC DEPS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [
        ":codecs",
        ":compressed_depth_image_transport",
    ],
    visibility = ["//visibility:private"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_codecs",
    dynamic_deps = [
        ":codecs",
    ],
    visibility = ["//visibility:private"],
)

### AMENT INDEX

ament_index(
    name = "ament_index",
    export_name = "compressed_depth_image_transport",
    libraries = [":compressed_depth_image_transport"],
    package_xml = "package.xml",
    plugin_category = "image_transport",
    plugins = ["compressed_depth_plugins.xml"],
)

### TESTS

cc_test(
    name = "rvl_codec_test",
    srcs = ["test/rvl_codec_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps_codecs"],
    deps = CODECS_DEPENDENCIES.values() + [
        ":codecs_library",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    headers = HEADERS,
    libraries = [
        ":codecs",
        ":compressed_depth_image_transport",
    ],
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_cmake//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@cv_bridge//:ament_package",
        "@image_transport//:ament_package",
        "@pluginlib//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
    ],
)
