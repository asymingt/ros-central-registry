load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

### PYTHON MODULE

genrule(
    name = "generate_version_py",
    outs = ["src/python_qt_binding/version.py"],
    cmd = "echo \"QT_MAJOR_VERSION = 6\" > $@",
)

py_library(
    name = "python_qt_binding",
    srcs = glob(["src/python_qt_binding/**/*.py"]) + [
        ":generate_version_py",
    ],
    imports = ["src"],
    deps = [
        requirement("PySide6"),
    ],
)

### TESTS

py_pytest(
    name = "test_imports",
    srcs = ["test/test_imports.py"],
    deps = [":python_qt_binding"],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_cmake_pytest//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
