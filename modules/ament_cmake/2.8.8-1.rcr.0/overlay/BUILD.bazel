load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_core//:ament_package",
        "@ament_cmake_export_definitions//:ament_package",
        "@ament_cmake_export_dependencies//:ament_package",
        "@ament_cmake_export_include_directories//:ament_package",
        "@ament_cmake_export_libraries//:ament_package",
        "@ament_cmake_export_link_flags//:ament_package",
        "@ament_cmake_export_targets//:ament_package",
        "@ament_cmake_gen_version_h//:ament_package",
        "@ament_cmake_libraries//:ament_package",
        "@ament_cmake_python//:ament_package",
        "@ament_cmake_target_dependencies//:ament_package",
        "@ament_cmake_test//:ament_package",
        "@ament_cmake_version//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
