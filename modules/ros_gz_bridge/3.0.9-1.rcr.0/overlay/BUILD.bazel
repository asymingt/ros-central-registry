cc_binary(
    name = "test_ros_subscriber",
    srcs = [
        "test/subscribers/ros_subscriber.cpp",
    ] + [
        "generated/test/%s_subscriber.cpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
    dynamic_deps = [":transitive_dynamic_deps"],
    includes = ["test/subscribers"],
    local_defines = ros_local_defines(),
    deps = [":test_utils"],
