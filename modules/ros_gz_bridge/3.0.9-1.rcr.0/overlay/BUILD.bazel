load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_library")
load("@rclcpp_components//:defs.bzl", "rclcpp_components_register_node")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

BRIDGE_MESSAGE_TYPES = [
    # "builtin_interfaces",
    "actuator_msgs",
    "geometry_msgs",
    "gps_msgs",
    "marine_acoustic_msgs",
    "nav_msgs",
    # "rcl_interfaces",
    "ros_gz_interfaces",
    "rosgraph_msgs",
    "sensor_msgs",
    "std_msgs",
    "tf2_msgs",
    "trajectory_msgs",
    "vision_msgs",
]

### PYTHON GENERATORS

py_library(
    name = "ros_gz_bridge_py",
    srcs = glob(["ros_gz_bridge/**/*.py"]),
    imports = ["."],
    deps = ["@rosidl_pycommon"],
)

genrule(
    name = "generate_factories_script_py",
    srcs = ["bin/ros_gz_bridge_generate_factories"],
    outs = ["bin/ros_gz_bridge_generate_factories.py"],
    cmd = "cp $< $@",
)

genrule(
    name = "generate_tests_script_py",
    srcs = ["bin/ros_gz_bridge_generate_tests"],
    outs = ["bin/ros_gz_bridge_generate_tests.py"],
    cmd = "cp $< $@",
)

py_binary(
    name = "ros_gz_bridge_generate_factories",
    srcs = ["bin/ros_gz_bridge_generate_factories.py"],
    main = "bin/ros_gz_bridge_generate_factories.py",
    deps = [":ros_gz_bridge_py"],
)

py_binary(
    name = "ros_gz_bridge_generate_tests",
    srcs = ["bin/ros_gz_bridge_generate_tests.py"],
    main = "bin/ros_gz_bridge_generate_tests.py",
    deps = [":ros_gz_bridge_py"],
)

### CODE GENERATION

genrule(
    name = "generate_factories",
    srcs = [
        "resource/get_factory.cpp.em",
        "resource/get_mappings.cpp.em",
        "resource/pkg_factories.cpp.em",
        "resource/pkg_factories.hpp.em",
    ],
    outs = [
        "generated/get_factory.cpp",
        "generated/get_mappings.cpp",
    ] + [
        "generated/factories/%s.cpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ] + [
        "generated/factories/%s.hpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
    cmd = "$(execpath :ros_gz_bridge_generate_factories) --output-path $(RULEDIR)/generated --template-dir $$(dirname $(location resource/get_factory.cpp.em)) --gz-msgs-ver 0.0.0",
    tools = [":ros_gz_bridge_generate_factories"],
)

genrule(
    name = "generate_test_helpers",
    srcs = [
        "test/resource/gz_publisher.cpp.em",
        "test/resource/gz_subscriber.cpp.em",
        "test/resource/ros_publisher.cpp.em",
        "test/resource/ros_pkg_subscriber.cpp.em",
    ],
    outs = [
        "generated/test/gz_publisher.cpp",
        "generated/test/gz_subscriber.cpp",
        "generated/test/ros_publisher.cpp",
    ] + [
        "generated/test/%s_subscriber.cpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
    cmd = "$(execpath :ros_gz_bridge_generate_tests) --output-path $(RULEDIR)/generated/test --template-dir $$(dirname $(location test/resource/gz_publisher.cpp.em)) --gz-msgs-ver 0.0.0",
    tools = [":ros_gz_bridge_generate_tests"],
)

### LIBRARIES

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rosdistro//cc:yaml-cpp": "@rosdistro//cc:yaml-cpp_library",
    "@rosdistro//cc:gz_msgs": "@rosdistro//cc:gz_msgs",
    "@rosdistro//cc:gz_transport": "@rosdistro//cc:gz_transport",
}

cc_library(
    name = "ros_gz_bridge_library",
    srcs = [
        "src/bridge_config.cpp",
        "src/bridge_handle.cpp",
        "src/bridge_handle_gz_to_ros.cpp",
        "src/bridge_handle_ros_to_gz.cpp",
        "src/convert/utils.cpp",
        "src/convert/utils.hpp",
        "src/factory_interface.cpp",
        "src/ros_gz_bridge.cpp",
        "src/service_factories/ros_gz_interfaces.cpp",
        "src/service_factory_interface.cpp",
    ] + [
        "src/convert/%s.cpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ] + [
        "generated/get_factory.cpp",
        "generated/get_mappings.cpp",
    ] + [
        "generated/factories/%s.cpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
    hdrs = glob(["include/**/*.hpp"]) + [
        "generated/factories/%s.hpp" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
    includes = [
        "generated",
        "include",
        "src",
    ],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        "@%s//:cc" % pkg
        for pkg in BRIDGE_MESSAGE_TYPES
    ],
)

cc_shared_library(
    name = "ros_gz_bridge",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":ros_gz_bridge_library"],
    deps = [":ros_gz_bridge_library"],
)

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":ros_gz_bridge"],
)

### COMPONENT REGISTRATION

rclcpp_components_register_node(
    name = "bridge_node",
    component = ":ros_gz_bridge",
    node_name = "bridge_node",
    plugin = "ros_gz_bridge::RosGzBridge",
)

### EXECUTABLES

cc_binary(
    name = "parameter_bridge",
    srcs = ["src/parameter_bridge.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_gz_bridge_library",
    ],
)

cc_binary(
    name = "static_bridge",
    srcs = ["src/static_bridge.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_gz_bridge_library",
    ],
)

cc_binary(
    name = "bridge_types",
    srcs = ["src/bridge_types.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    local_defines = ros_local_defines(),
    deps = DEPENDENCIES.values() + [
        ":ros_gz_bridge_library",
    ],
)

