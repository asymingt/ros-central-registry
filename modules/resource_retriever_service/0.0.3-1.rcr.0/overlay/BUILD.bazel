load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")

package(default_visibility = ["//visibility:public"])

### LIBRARIES

DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
}

cc_library(
    name = "resource_retriever_service_library",
    srcs = ["src/resource_retriever_service.cpp"],
    hdrs = glob([
        "include/**/*.hpp",
        "include/**/*.h",
    ]),
    includes = ["include"],
    local_defines = ros_local_defines() + ["RESOURCE_RETRIEVER_SERVICE_BUILDING_DLL"],
    deps = DEPENDENCIES.values() + [
        "@resource_retriever_interfaces//:cc",
    ],
)

cc_shared_library(
    name = "resource_retriever_service",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [":resource_retriever_service_library"],
    deps = [":resource_retriever_service_library"],
)

### TESTS

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps",
    dynamic_deps = [":resource_retriever_service"],
    visibility = ["//visibility:private"],
)

cc_test(
    name = "test_all",
    srcs = ["test/resource_retriever_service_test.cpp"],
    dynamic_deps = [":transitive_dynamic_deps"],
    deps = DEPENDENCIES.values() + [
        ":resource_retriever_service_library",
        "@resource_retriever_interfaces//:cc",
        "@rosdistro//cc:googletest",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rclcpp//:ament_package",
        "@resource_retriever_interfaces//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
