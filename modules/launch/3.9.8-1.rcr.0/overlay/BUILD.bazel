load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = ["share/launch/frontend/grammar.lark"],
    data_strip_prefix = "share/launch",
    package_xml = "package.xml",
)
### PYTHON MODULE

py_library(
    name = "launch",
    srcs = glob(["launch/**/*.py"]),
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        requirement("typing_extensions"),
        requirement("pyyaml"),
        requirement("osrf-pycommon"),
        requirement("lark"),
    ],
)

### TESTS

py_library(
    name = "test_support",
    srcs = ["test/temporary_environment.py"],
    imports = ["test"],
)

[
    py_pytest(
        name = test,
        srcs = ["test/launch/{0}.py".format(test)],
        data = glob(["test/**"]),
        deps = [
            ":launch",
            ":test_support",
            "@rules_python//python/runfiles",
        ],
    )
    for test in [
        "test_action",
        "test_condition",
        "test_event_handler",
        "test_event",
        "test_executable",
        "test_execute_local",
        "test_execute_process",
        "test_invalid_launch_file_error",
        "test_launch_context",
        "test_launch_description_entity",
        "test_launch_description",
        "test_launch_description_source",
        "test_launch_service",
        "test_logging",
        "test_on_include_launch_description",
        "test_on_process_exit",
        "test_on_process_io",
        "test_on_process_start",
        "test_on_shutdown",
        "test_timer_action",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "mypy",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        ":ament_index",
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_mypy//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
