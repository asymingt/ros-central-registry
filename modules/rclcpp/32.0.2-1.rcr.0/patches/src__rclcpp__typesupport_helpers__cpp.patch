+static std::string pascal_to_snake_case(std::string_view str)
+{
+  std::string result;
+  result.reserve(2 * str.size());
+  for (size_t i = 0; i < str.size(); ++i) {
+    char ch = str[i];
+    if (std::isupper(ch)) {
+      if (i > 0 && str[i - 1] != '_') {
+        if (std::islower(str[i - 1]) || (i + 1 < str.size() && std::islower(str[i + 1]))) {
+          result.push_back('_');
+        }
+      }
+      result.push_back(std::tolower(ch));
+    } else {
+      result.push_back(ch);
+    }
+  }
+  return result;
