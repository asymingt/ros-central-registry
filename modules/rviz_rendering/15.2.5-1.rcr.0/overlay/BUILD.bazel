load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "collect_transitive_dynamic_deps", "ros_local_defines")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library", "cc_test")
load("@rules_qt//:qt.bzl", "qt_cc_library")

package(default_visibility = ["//visibility:public"])

### DATA

ament_index(
    name = "ament_index",
    data = glob(["ogre_media/**"]),
    package_xml = "package.xml",
    deps = ["@rviz_ogre_vendor//:ament_index"],
)

### LIBRARIES

DEPENDENCIES = {
    "@ament_index_cpp//:ament_index_cpp": "@ament_index_cpp//:ament_index_cpp_library",
    "@resource_retriever//:resource_retriever": "@resource_retriever//:resource_retriever_library",
    "@rosdistro//cc:curl": "@rosdistro//cc:curl_library",
    "@rosdistro//cc:OgreMain": "@rosdistro//cc:OgreMain_library",
    "@rosdistro//cc:OgreOverlay": "@rosdistro//cc:OgreOverlay_library",
}

qt_cc_library(
    name = "rviz_rendering_library",
    srcs = glob([
        "src/rviz_rendering/**/*.hpp",
        "src/rviz_rendering/**/*.cpp",
    ]),
    hdrs = glob(["include/**/*.hpp"]),
    data = [
        "@rosdistro//cc:Codec_STBI",
        "@rosdistro//cc:RenderSystem_GL",
        "@rosdistro//cc:RenderSystem_GL3Plus",
    ],
    includes = ["include"],
    local_defines = ros_local_defines() + [
        "RVIZ_RENDERING_BUILDING_LIBRARY",
    ],
    deps = DEPENDENCIES.values() + [
        "@rosdistro//cc:RenderSystems",
        "@rosdistro//cc:assimp",
        "@rosdistro//cc:eigen",
        "@rules_qt//:qt",
        "@rules_qt//:qt_widgets",
    ],
)

cc_shared_library(
    name = "rviz_rendering",
    dynamic_deps = DEPENDENCIES.keys(),
    exports_filter = [
        ":rviz_rendering_library",
        "@rules_qt//:qt",
        "@rules_qt//:qt_widgets",
    ],
    user_link_flags = [
        "-lGL",
        "-lX11",
    ],
    deps = [":rviz_rendering_library"],
)

### TESTS

cc_library(
    name = "rviz_rendering_test_utils_library",
    srcs = [
        "test/rviz_rendering/ogre_testing_environment.cpp",
        "test/rviz_rendering/scene_graph_introspection.cpp",
    ],
    hdrs = [
        "test/rviz_rendering/matcher.hpp",
        "test/rviz_rendering/ogre_testing_environment.hpp",
        "test/rviz_rendering/scene_graph_introspection.hpp",
        "test/rviz_rendering/visibility_control.hpp",
    ],
    data = [":ament_index"],
    includes = ["test"],
    local_defines = ros_local_defines() + ["RVIZ_RENDERING_PUBLIC="],
    deps = DEPENDENCIES.values() + [
        ":rviz_rendering_library",
    ],
)

cc_shared_library(
    name = "rviz_rendering_test_utils",
    dynamic_deps = DEPENDENCIES.keys() + [
        ":rviz_rendering",
    ],
    exports_filter = [":rviz_rendering_test_utils_library"],
    deps = [":rviz_rendering_test_utils_library"],
)

TEST_DEPENDENCIES = DEPENDENCIES | {
    ":rviz_rendering": ":rviz_rendering_library",
    ":rviz_rendering_test_utils": ":rviz_rendering_test_utils_library",
}

collect_transitive_dynamic_deps(
    name = "transitive_dynamic_deps_test",
    dynamic_deps = TEST_DEPENDENCIES.keys(),
    visibility = ["//visibility:private"],
)

[
    cc_test(
        name = test,
        srcs = srcs,
        dynamic_deps = [":transitive_dynamic_deps_test"],
        linkstatic = True,
        local_defines = ros_local_defines() + ["RVIZ_RENDERING_PUBLIC="],
        tags = ["no-sandbox"],
        deps = TEST_DEPENDENCIES.values() + [
            "@rosdistro//cc:googletest",
        ],
    )
    for test, srcs in {
        "billboard_line_test": ["test/rviz_rendering/objects/billboard_line_test.cpp"],
        "covariance_visual_test": ["test/rviz_rendering/objects/covariance_visual_test.cpp"],
        "effort_visual_test": ["test/rviz_rendering/objects/effort_visual_test.cpp"],
        "grid_test": ["test/rviz_rendering/objects/grid_test.cpp"],
        "line_test": ["test/rviz_rendering/objects/line_test.cpp"],
        "movable_text_test": ["test/rviz_rendering/objects/movable_text_test.cpp"],
        "point_cloud_renderable_test": ["test/rviz_rendering/objects/point_cloud_renderable_test.cpp"],
        "point_cloud_test": ["test/rviz_rendering/objects/point_cloud_test.cpp"],
        "screw_visual_test": ["test/rviz_rendering/objects/screw_visual_test.cpp"],
        "triangle_polygon_test": ["test/rviz_rendering/objects/triangle_polygon_test.cpp"],
        "wrench_visual_test": ["test/rviz_rendering/objects/wrench_visual_test.cpp"],
        "string_helper_test": ["test/rviz_rendering/string_helper_test.cpp"],
    }.items()
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake_gmock//:ament_package",
        "@ament_cmake_gtest//:ament_package",
        "@ament_cmake_ros//:ament_package",
        "@ament_index_cpp//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@eigen3_cmake_module//:ament_package",
        "@resource_retriever//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
