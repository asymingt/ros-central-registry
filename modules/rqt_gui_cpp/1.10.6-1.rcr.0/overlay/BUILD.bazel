load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//cc:defs.bzl", "ros_local_defines")
load("@rules_qt//:qt.bzl", "qt_cc_library")

package(default_visibility = ["//visibility:public"])

### DATA

ament_index(
    name = "ament_index",
    data = ["plugin.xml"],
    package_xml = "package.xml",
)

### LIBRARIES

qt_cc_library(
    name = "rqt_gui_cpp",
    srcs = [
        "src/rqt_gui_cpp/nodelet_plugin_provider.cpp",
        "src/rqt_gui_cpp/nodelet_plugin_provider.hpp",
        "src/rqt_gui_cpp/roscpp_plugin_provider.cpp",
        "src/rqt_gui_cpp/roscpp_plugin_provider.hpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = [
        "@pluginlib//:pluginlib_library",
        "@qt_gui_cpp",
        "@rclcpp//:rclcpp_library",
        "@rules_qt//:qt_widgets",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@pluginlib//:ament_package",
        "@qt_gui_cpp//:ament_package",
        "@rclcpp//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
