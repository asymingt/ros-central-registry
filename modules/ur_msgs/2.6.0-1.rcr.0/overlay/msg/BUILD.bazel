load("@rosidl_default_generators//:defs.bzl", "ros_message")

package(default_visibility = ["//visibility:public"])

exports_files(glob(["*.msg"]))

ros_message(
    name = "Analog",
    src = "Analog.msg",
)

ros_message(
    name = "Digital",
    src = "Digital.msg",
)

ros_message(
    name = "FrictionModelParameters",
    src = "FrictionModelParameters.msg",
)

ros_message(
    name = "IOStates",
    src = "IOStates.msg",
    deps = [
        ":Analog",
        ":Digital",
    ],
)

ros_message(
    name = "MasterboardDataMsg",
    src = "MasterboardDataMsg.msg",
)

ros_message(
    name = "RobotModeDataMsg",
    src = "RobotModeDataMsg.msg",
)

ros_message(
    name = "RobotStateRTMsg",
    src = "RobotStateRTMsg.msg",
)

ros_message(
    name = "ToolDataMsg",
    src = "ToolDataMsg.msg",
)
