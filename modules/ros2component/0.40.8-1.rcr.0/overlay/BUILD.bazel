load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

### DATA

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    package_xml = "package.xml",
)

### PYTHON MODULE

py_library(
    name = "ros2component",
    srcs = glob(["ros2component/**/*"]),
    data = [":ament_index"],
    imports = ["."],
    deps = [
        "@ament_index_python",
        "@composition_interfaces//:py",
        "@rcl_interfaces//:py",
        "@rclpy",
        "@ros2cli",
        "@ros2node",
        "@ros2pkg",
    ],
)

### TESTS

[
    py_pytest(
        name = test,
        srcs = ["test/{0}.py".format(test)],
        deps = [":ros2component"],
    )
    for test in [
        "test_api",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@composition_interfaces//:ament_package",
        "@rcl_interfaces//:ament_package",
        "@rclcpp_components//:ament_package",
        "@rclpy//:ament_package",
        "@ros2cli//:ament_package",
        "@ros2node//:ament_package",
        "@ros2param//:ament_package",
        "@ros2pkg//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
