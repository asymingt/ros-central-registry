load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
)

# NOTE: only the subset of ouster-sdk that ouster_ros actually configures is
# wired up here (BUILD_SENSOR only -- see ouster_ros's own CMakeLists.txt,
# which explicitly disables BUILD_PCAP/BUILD_OSF/BUILD_MAPPING/BUILD_VIZ when
# it configures this subdirectory). Mirrors ouster-sdk/ouster_client/CMakeLists.txt.
cc_library(
    name = "ouster_client",
    srcs = glob([
        "src/*.cpp",
        "src/*.h",
        "src/lsp/*.h",
    ]),
    hdrs = glob(["include/ouster/**/*.h"]),
    # ouster-sdk's own CMakeLists.txt adds
    # "../thirdparty/spdlog" (i.e. this package's sibling thirdparty/spdlog
    # dir) as the private spdlog include path, but the actual #includes in
    # this library's sources (e.g. <spdlog/fmt/bundled/args.h>) only resolve
    # against "../thirdparty" -- see AGENTS.md's note on not trusting
    # upstream CMakeLists.txt include paths at face value.
    copts = ["-DEIGEN_MPL2_ONLY"],
    includes = [
        "include",
        "include/optional-lite",
    ],
    deps = [
        "//ouster-sdk/thirdparty:spdlog",
        "//ouster-sdk/thirdparty/nmea",
        "@rosdistro//cc:boringssl_crypto_library",
        "@rosdistro//cc:boringssl_ssl_library",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:libzip_library",
    ],
)
