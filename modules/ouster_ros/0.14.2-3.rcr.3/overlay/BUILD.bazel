### TESTS

cc_test(
    name = "ouster_ros_test",
    srcs = [
        "src/lock_free_ring_buffer.h",
        "src/os_ros.cpp",
        "src/point_cloud_compose.h",
        "src/point_meta_helpers.h",
        "test/lock_free_ring_buffer_test.cpp",
        "test/point_accessor_test.cpp",
        "test/point_cloud_compose_test.cpp",
        "test/point_transform_test.cpp",
        "test/test_main.cpp",
    ],
    copts = ["-DEIGEN_MPL2_ONLY"],
    # Everything os_ros.cpp itself needs (opencv, pcl, eigen, message types,
    # ...) already comes in transitively via :ouster_ros_library -- the test
    # files themselves only touch gtest, ouster/lidar_scan.h (via
    # ouster_ros_library -> ouster-sdk/ouster_sensor), and these package's
    # own public/private headers, so nothing else needs to be re-listed here.
    dynamic_deps = [":ouster_ros_transitive"],
    includes = ["include"],
    deps = BASE_DEPENDENCIES.values() + [
        ":ouster_ros_library",
        "@rosdistro//cc:bazel_test_helper",
        "@rosdistro//cc:googletest",
    ],
)

