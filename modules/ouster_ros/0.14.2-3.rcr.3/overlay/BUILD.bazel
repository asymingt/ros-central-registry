# NOTE: only the BUILD_SENSOR subset is wired up (matching this package's own
# CMakeLists.txt, which disables BUILD_PCAP/BUILD_OSF/BUILD_MAPPING/BUILD_VIZ
# when configuring the bundled ouster-sdk) -- so there is no os_pcap
# component here, matching upstream's own default (non-PCAP) build.

HEADERS = glob(["include/**/*.h"])

### BASE LIBRARY

# Dynamic (cross-.so singleton/registry state) vs. static deps, mirroring
# ouster_ros_library's own CMakeLists.txt target_link_libraries/
# ament_target_dependencies calls. tf2 itself is not a bazel_dep of this
# package -- CMakeLists.txt's ament_target_dependencies lists it directly,
# but package.xml never declares it (a latent upstream packaging omission,
# only masked in CMake because tf2_eigen/tf2_ros transitively bring it in).
# tf2_eigen's own DEPENDENCIES already includes @tf2//:tf2(_library), so
# depending on tf2_eigen here provides tf2 transitively without needing a
# bazel_dep this package doesn't actually declare.
BASE_DEPENDENCIES = {
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@tf2_eigen//:tf2_eigen": "@tf2_eigen//:tf2_eigen_library",
}

cc_library(
    name = "ouster_ros_library",
    srcs = ["src/os_ros.cpp"],
    hdrs = HEADERS,
    copts = ["-DEIGEN_MPL2_ONLY"],
    includes = ["include"],
    local_defines = ros_local_defines(),
    deps = BASE_DEPENDENCIES.values() + [
        "//ouster-sdk/ouster_sensor",
        "@geometry_msgs//:cc",
        "@ouster_sensor_msgs//:cc",
        "@pcl_conversions//:pcl_conversions_library",
        "@rosdistro//cc:eigen",
        "@rosdistro//cc:opencv_library",
        "@rosdistro//cc:pcl_common",
        "@sensor_msgs//:cc",
    ],
)

cc_shared_library(
    name = "ouster_ros",
    dynamic_deps = BASE_DEPENDENCIES.keys(),
    exports_filter = [":ouster_ros_library"],
    deps = [":ouster_ros_library"],
)

collect_transitive_dynamic_deps(
    name = "ouster_ros_transitive",
    dynamic_deps = [":ouster_ros"],
    visibility = ["//visibility:private"],
)

### COMPONENTS

# Common to every component, mirroring CMakeLists.txt's create_ros2_component
# function.
COMPONENT_DEPENDENCIES = {
    "@class_loader//:class_loader": "@class_loader//:class_loader_library",
    "@rclcpp//:rclcpp": "@rclcpp//:rclcpp_library",
    "@rclcpp_components//:rclcpp_components": "@rclcpp_components//:rclcpp_components_library",
    "@rclcpp_lifecycle//:rclcpp_lifecycle": "@rclcpp_lifecycle//:rclcpp_lifecycle_library",
}

# ==== os_sensor_component ====

cc_library(
    name = "os_sensor_component_library",
    srcs = [
        "src/os_sensor_node.cpp",
        "src/os_sensor_node_base.cpp",
    ],
    hdrs = HEADERS,
    includes = ["include"],
    local_defines = ros_local_defines() + ["OUSTER_ROS_BUILDING_DLL"],
    deps = COMPONENT_DEPENDENCIES.values() + [
        ":ouster_ros_library",
        "@geometry_msgs//:cc",
        "@sensor_msgs//:cc",
        "@std_msgs//:cc",
        "@std_srvs//:cc",
    ],
)

cc_shared_library(
    name = "os_sensor_component",
    dynamic_deps = COMPONENT_DEPENDENCIES.keys() + [":ouster_ros"],
    exports_filter = [":os_sensor_component_library"],
    deps = [":os_sensor_component_library"],
)

rclcpp_components_register_node(
    name = "os_sensor",
    component = ":os_sensor_component",
    node_name = "os_sensor",
    plugin = "ouster_ros::OusterSensor",
)

