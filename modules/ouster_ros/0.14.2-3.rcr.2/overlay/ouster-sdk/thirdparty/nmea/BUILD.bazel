load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

# Small bundled NMEA sentence parser (github.com/pcdangio/cpp-nmea), vendored
# directly inside ouster-sdk under thirdparty/ rather than fetched as its own
# dependency.
cc_library(
    name = "nmea",
    srcs = glob([
        "src/*.cpp",
        "src/*.hpp",
    ]),
    hdrs = glob(["include/**/*.hpp"]),
    includes = ["include"],
)
