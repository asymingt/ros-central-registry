load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":spdlog_license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "spdlog_license",
    package_name = "spdlog",
    license_kinds = [
        "@rules_license//licenses/spdx:MIT",
    ],
)

# Bundled header-only spdlog (github.com/gabime/spdlog), vendored under
# thirdparty/spdlog rather than fetched as its own dependency. Only spdlog is
# exposed here -- this directory also bundles jsoncons/kiss-icp/glad/sophus/
# zpng, but those are only used by ouster_mapping/ouster_viz/ouster_osf,
# which ouster_ros's CMakeLists.txt disables (BUILD_MAPPING/BUILD_VIZ/
# BUILD_OSF all OFF) and so aren't wired up here.
cc_library(
    name = "spdlog",
    hdrs = glob(["spdlog/**/*.h"]),
    includes = ["."],
)
