# ROS package information
module(
    name = "ouster_sensor_msgs",
    version = "0.14.2-3.rcr.2",
    bazel_compatibility = [">=7.2.1"],
)

# BCR dependencies
bazel_dep(name = "aspect_rules_py", version = "1.11.7")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "cmake_configure_file", version = "0.1.7")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "llvm", version = "0.8.11")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_build_error", version = "0.11.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_qt", version = "0.0.6")
bazel_dep(name = "rules_rs", version = "0.0.93")
bazel_dep(name = "rules_rust", version = "0.71.3")
bazel_dep(name = "rules_shell", version = "0.8.0")

# RCR Dependencies
bazel_dep(name = "ament_cmake", version = "2.8.7-3.rcr.1")
bazel_dep(name = "ament_lint_auto", version = "0.20.6-1.rcr.1")
bazel_dep(name = "ament_lint_common", version = "0.20.6-1.rcr.1")
bazel_dep(name = "rosdistro", version = "lyrical.2026-06-08.rcr.1")
bazel_dep(name = "rosidl_default_generators", version = "1.8.1-3.rcr.1")
bazel_dep(name = "rosidl_default_runtime", version = "1.8.1-3.rcr.1")
bazel_dep(name = "std_msgs", version = "5.9.2-3.rcr.1")

# Setup Python
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# Setup Pip
pip_ros = use_extension("@rosdistro//python:defs.bzl", "pip_ros")
use_repo(pip_ros, "pip_ros")

# Setup Qt6
qt = use_extension("@rules_qt//extension:qt.bzl", "fetch")
qt.install(
    name = "qt_linux_x86_64",
    build_file = "@rules_qt//extension:qt/6.8.3/linux_x86_64.BUILD",
    os = "linux",
    version = "6.8.3",
)
use_repo(qt, "qt_linux_x86_64")

register_toolchains("@rules_qt//tools:all")
