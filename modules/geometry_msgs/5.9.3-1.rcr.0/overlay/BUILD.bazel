load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosidl_default_generators//:defs.bzl", "default_generators")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = [
        "@rules_license//licenses/spdx:Apache-2.0",
    ],
)

default_generators(
    package_xml = "package.xml",
    deps = [
        "//msg:Accel",
        "//msg:AccelStamped",
        "//msg:AccelWithCovariance",
        "//msg:AccelWithCovarianceStamped",
        "//msg:Inertia",
        "//msg:InertiaStamped",
        "//msg:Point",
        "//msg:Point32",
        "//msg:PointStamped",
        "//msg:Polygon",
        "//msg:PolygonInstance",
        "//msg:PolygonInstanceStamped",
        "//msg:PolygonStamped",
        "//msg:Pose",
        "//msg:PoseArray",
        "//msg:PoseStamped",
        "//msg:PoseWithCovariance",
        "//msg:PoseWithCovarianceStamped",
        "//msg:Quaternion",
        "//msg:QuaternionStamped",
        "//msg:Transform",
        "//msg:TransformStamped",
        "//msg:Twist",
        "//msg:TwistStamped",
        "//msg:TwistWithCovariance",
        "//msg:TwistWithCovarianceStamped",
        "//msg:Vector3",
        "//msg:Vector3Stamped",
        "//msg:VelocityStamped",
        "//msg:Wrench",
        "//msg:WrenchStamped",
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_lint_common//:ament_package",
        "@rosdistro//:ament_package",
        "@rosidl_default_generators//:ament_package",
        "@rosidl_default_runtime//:ament_package",
        "@std_msgs//:ament_package",
    ],
)
