load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@pip_ros//:requirements.bzl", "requirement")
load("@rosdistro//ament:defs.bzl", "ament_index", "ament_package")

package(default_visibility = ["//visibility:public"])

### PYTHON MODULES

ament_index(
    name = "ament_index",
    data = glob(["resource/**"]),
    package_xml = "package.xml",
)

py_library(
    name = "qt_gui",
    srcs = glob(["src/qt_gui/**/*.py"]),
    data = [":ament_index"],
    imports = ["src"],
    deps = [
        "@ament_index_python",
        "@python_qt_binding",
        requirement("packaging"),
        requirement("catkin-pkg"),
    ],
)

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_cmake//:ament_package",
        "@ament_index_python//:ament_package",
        "@ament_lint_auto//:ament_package",
        "@ament_lint_common//:ament_package",
        "@python_qt_binding//:ament_package",
        "@rosdistro//:ament_package",
    ],
)
