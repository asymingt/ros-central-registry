load("@aspect_rules_py//py:defs.bzl", "py_library")
load("@rosdistro//ament:defs.bzl", "ament_package")
load("@rosdistro//python:defs.bzl", "py_pytest")

package(default_visibility = ["//visibility:public"])

py_library(
    name = "tf2_ros_py",
    srcs = glob(["tf2_ros/**/*.py"]),
    imports = ["."],
    deps = [
        "@geometry_msgs//:py",
        "@rclpy",
        "@sensor_msgs//:py",
        "@std_msgs//:py",
        "@tf2_msgs//:py",
        "@tf2_py",
    ],
)

### TESTING

[
    py_pytest(
        name = name,
        srcs = ["test/{}.py".format(name)],
        deps = [
            ":tf2_ros_py",
            "@rules_python//python/runfiles",
        ],
    )
    for name in [
        "test_buffer",
        "test_buffer_client",
        "test_listener_and_broadcaster",
    ]
]

[
    py_pytest(
        name = "test_{0}".format(linter),
        srcs = ["test/test_{0}.py".format(linter)],
        data = glob(["**/*"]),
        deps = ["@ament_{0}".format(linter)],
    )
    for linter in [
        "copyright",
        "flake8",
        "pep257",
        "xmllint",
    ]
]

### PACKAGING

ament_package(
    name = "ament_package",
    package_xml = "package.xml",
    deps = [
        "@ament_copyright//:ament_package",
        "@ament_flake8//:ament_package",
        "@ament_pep257//:ament_package",
        "@ament_xmllint//:ament_package",
        "@geometry_msgs//:ament_package",
        "@rclpy//:ament_package",
        "@rosdistro//:ament_package",
        "@sensor_msgs//:ament_package",
        "@std_msgs//:ament_package",
        "@tf2_msgs//:ament_package",
        "@tf2_py//:ament_package",
    ],
)
